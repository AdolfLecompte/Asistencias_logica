# ─────────────────────────────────────────────
# CONFIGURACIÓN BOT DE ASISTENCIAS
# ─────────────────────────────────────────────

# Token de BotFather (obligatorio)
TELEGRAM_TOKEN=TU_TOKEN_AQUI

# ID del grupo/canal donde se enviarán las encuestas automáticas.
# Déjalo en 0 para desactivar las encuestas automáticas.
GRUPO_ID=0

# IDs de Telegram de los administradores separados por coma.
# Solo ellos podrán usar /asistencia, /reporte y /cerrar.
# Si se deja vacío, cualquier usuario puede ejecutar esos comandos.
ADMIN_IDS=

# Nombre de la materia (aparece en las encuestas automáticas)
NOMBRE_MATERIA=Programación Web

# ── Ollama ──────────────────────────────────────
# URL del servidor Ollama
OLLAMA_URL=http://localhost:11434

# Modelo multimodal a usar (debe soportar imágenes)
OLLAMA_MODEL=gemma3:4b

# ── Base de datos y archivos ─────────────────────
DB_FILE=asistencias.db
EVIDENCIAS_DIR=evidencias

# ── Horario automático ───────────────────────────
# Días de clase: 0=Lun, 1=Mar, 2=Mié, 3=Jue, 4=Vie, 5=Sáb, 6=Dom
DIAS_CLASE=0,2,4

# Hora de envío de la encuesta (formato HH:MM)
HORA_INICIO=08:00

# Zona horaria (formato IANA)
TZ=America/Bogota

# Tiempo máximo de la encuesta en minutos (reservado para uso futuro)
DURACION_ENCUESTA_MINUTOS=30

# ── API / Dashboard ──────────────────────────────────────────
# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://bot_asistencias:cambia_esta_password@localhost:5432/asistencias_db

# Clave secreta para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_este_secreto_en_produccion

# Expiración del access token en minutos (recomendado: 60)
JWT_ACCESS_EXPIRE_MINUTES=60

# Expiración del refresh token en días (recomendado: 7)
JWT_REFRESH_EXPIRE_DAYS=7

# Orígenes permitidos para CORS (separados por coma)
# En desarrollo: http://localhost:3000,http://localhost:8080
# En producción: https://tu-dominio.com
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
